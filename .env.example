# Groq LPU Inference API Key (Required for LLM Agents)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database Configuration (Defaults to local SQLite if left empty)
# For local use: file:data/local.db (no auth token required)
# For Turso Cloud: libsql://your-db.turso.io
TURSO_DATABASE_URL=file:data/local.db
TURSO_AUTH_TOKEN=

# Tavily AI Search (Optional - provides live Reddit, X, and forum sentiment)
TAVILY_API_KEY=tvly-your_tavily_key_here

# Node Environment
NODE_ENV=development
